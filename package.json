{
  "name": "secure-live-messaging",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names server,client \"npm run dev -w @slm/server\" \"npm run start -w @slm/client\"",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "e2e": "playwright test --pass-with-no-tests"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "concurrently": "9.2.5"
  }
}
